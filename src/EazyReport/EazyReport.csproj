<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net8.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet Package Metadata -->
    <PackageId>EazyReport</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ashiq Kodali, Thameem PK</Authors>
    <Company>EazyReport</Company>
    <Product>EazyReport</Product>
    <Description>Modern banded document and invoice reporting engine for .NET. Render .rtpl templates to printable HTML and vector PDF without JavaScript or browser runtimes.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://eazyreport.in</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ashiq-kodali/eazyreport-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>reporting;report;invoice;pdf;printing;barcode;qrcode;chart;rtpl;fastreport;html;handlebars;csharp;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>
